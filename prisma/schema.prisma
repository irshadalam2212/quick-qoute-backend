generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int         @id @default(autoincrement())
  name            String
  email           String      @unique
  password        String
  role            String      @default("USER")
  refreshToken    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  address         String?     @db.Text
  alternateMobile String?
  companyName     String?
  gstNumber       String?
  logo            String?
  mobileNumber    String?
  panNumber       String?
  services        String?     @db.Text
  signature       String?
  website         String?
  categories      Category[]  @relation("UserCategories")
  invoices        Invoice[]
  items           Item[]      @relation("UserItems")
  quotations      Quotation[]
  featurePermissions UserFeaturePermission[]
}

model UserFeaturePermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  feature   String   @db.VarChar(64)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature])
  @@index([feature])
}

model Quotation {
  id           Int             @id @default(autoincrement())
  quotationNo  String          @unique
  date         DateTime        @default(now())
  clientName   String?
  projectName  String?
  address      String
  instructions String?
  subtotal     Float
  taxRate      Float           @default(0)
  taxAmount    Float           @default(0)
  discount     Float           @default(0)
  grandTotal   Float
  status       QuotationStatus @default(DRAFT)
  createdById  Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  invoices     Invoice[]
  createdBy    User            @relation(fields: [createdById], references: [id])
  items        QuotationItem[]

  @@index([createdById], map: "Quotation_createdById_fkey")
}

model QuotationItem {
  id          Int       @id @default(autoincrement())
  description String    @db.Text
  quantity    Int
  price       Float
  taxRate     Float     @default(0)
  total       Float
  quotationId Int
  unitId      Int
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  unit        Unit      @relation(fields: [unitId], references: [id])

  @@index([quotationId], map: "QuotationItem_quotationId_fkey")
  @@index([unitId], map: "QuotationItem_unitId_fkey")
}

model Item {
  id          Int      @id @default(autoincrement())
  description String   @db.Text
  baseRate    Float
  taxRate     Float?   @default(0)
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  categoryId  Int
  unitId      Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdBy   User?    @relation("UserItems", fields: [createdById], references: [id])
  unit        Unit     @relation(fields: [unitId], references: [id])

  @@index([categoryId], map: "Item_categoryId_fkey")
  @@index([createdById], map: "Item_createdById_fkey")
  @@index([unitId], map: "Item_unitId_fkey")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  clientName    String
  address       String
  subtotal      Float
  taxRate       Float         @default(0)
  taxAmount     Float         @default(0)
  discount      Float         @default(0)
  grandTotal    Float
  paymentStatus PaymentStatus @default(UNPAID)
  quotationId   Int
  createdById   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     User          @relation(fields: [createdById], references: [id])
  quotation     Quotation     @relation(fields: [quotationId], references: [id])
  items         InvoiceItem[]

  @@index([createdById], map: "Invoice_createdById_fkey")
  @@index([quotationId], map: "Invoice_quotationId_fkey")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  description String  @db.Text
  quantity    Int
  price       Float
  taxRate     Float   @default(0)
  total       Float
  invoiceId   Int
  unitId      Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  unit        Unit    @relation(fields: [unitId], references: [id])

  @@index([invoiceId], map: "InvoiceItem_invoiceId_fkey")
  @@index([unitId], map: "InvoiceItem_unitId_fkey")
}

model Unit {
  id             Int             @id @default(autoincrement())
  name           String
  shortName      String          @unique
  category       String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoiceItems   InvoiceItem[]
  items          Item[]
  quotationItems QuotationItem[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("UserCategories", fields: [createdById], references: [id])
  items       Item[]

  @@index([createdById], map: "Category_createdById_fkey")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}
